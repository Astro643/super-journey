# Agent (Reverie) — unified Remix backend modules

# Better Auth — email+password accounts (no email verification)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://your-app.onrender.com

# Render Postgres — agent state (goals, plans, events) + auth tables
# Use the INTERNAL connection string (same-region private network) on Render.
DATABASE_URL=

# Upstash Redis — live status / support chat persistence / goal→box mapping
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Upstash Box — sandboxed execution environment for agent steps
# (shell via box.exec, headless Chromium via box.browser)
UPSTASH_BOX_API_KEY=
# Optional override for the box API base URL
# UPSTASH_BOX_BASE_URL=

# Google Gemini — task understanding + support assistant
GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Agent execution guardrails (all optional)
AGENT_MAX_STEPS=50
AGENT_STEP_TIMEOUT_MS=600000
AGENT_TASK_TIMEOUT_MS=1800000
AGENT_DAILY_CAP=25
AGENT_CONFIRM_TTL_HOURS=24
AGENT_STEP_RUNNER_CONCURRENCY=4
AGENT_MAX_LIVE_OBJECTIVES=20
