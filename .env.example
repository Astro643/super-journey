# Controller — unified Remix app env vars

# ── Required ──────────────────────────────────────────────────────────

# Render Postgres — INTERNAL connection string (same-region private network).
# Render dashboard → your Postgres → Connections → "Internal Database URL".
# Used for agent state (goals) AND Better Auth tables.
DATABASE_URL=

# Better Auth — any long random string (e.g. `openssl rand -base64 32`)
BETTER_AUTH_SECRET=
# Public URL of this service, e.g. https://controller.onrender.com
BETTER_AUTH_URL=

# Upstash Redis — Upstash console → your Redis DB → REST API tab
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Upstash Box — Upstash console → Box → API keys
UPSTASH_BOX_API_KEY=

# Google Gemini — aistudio.google.com → "Get API key"
# Single key: GEMINI_API_KEY=...
# Multiple keys (rotated on quota errors): GEMINI_API_KEYS=key1,key2,key3
# or GEMINI_API_KEY_1=... GEMINI_API_KEY_2=...
GEMINI_API_KEY=

# ── Optional ──────────────────────────────────────────────────────────

# Model overrides (defaults shown)
# MODEL_STRONG=gemini-3.8-flash
# MODEL_LITE=gemini-3.5-flash-lite
# MODEL_SUPPORT=gemma-4

# PORT — Render injects this automatically; only set for local dev
# PORT=44100
